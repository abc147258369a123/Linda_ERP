# =====================================================================
# Linda_ERP 环境变量示例
# 复制为 .env 后修改；标记 [机密] 的变量必须更换为强随机值
# =====================================================================

# ---------- 基础运行 ----------
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_VERSION=1.8.0
WORKERS=2
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_DIR=/app/logs
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# ---------- 数据库（MariaDB 10.11） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
# 数据库名：v1.3.0 起使用迁移后的新库 linda_erp_v2
# 原库 linda_erp 保留不动，可随时把此值改回 linda_erp 回滚
DB_NAME=linda_erp_v2
DB_USER=linda_erp
# [机密] 业务账号密码
DB_PASSWORD=change_me_db_password
# [机密] root 密码（仅初始化/维护使用）
DB_ROOT_PASSWORD=change_me_root_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- JWT ----------
# [机密] 使用 `openssl rand -hex 32` 生成
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- CORS（前端来源，逗号分隔） ----------
# 同域部署（Nginx 反代 /api）时 CORS 非必需，保留便于本地联调
CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,http://raspberrypi.local

# ---------- 初始超级管理员（部署脚本使用，机密） ----------
INIT_ADMIN_USERNAME=superadmin
INIT_ADMIN_NAME=周明
INIT_ADMIN_ROLE=super
# [机密] 首次初始化后建议修改
INIT_ADMIN_PASSWORD=change_me_admin_password

# ---------- 国内网络 / 镜像（按需调整） ----------
# Docker Hub 无法直连时使用镜像前缀（官方镜像需带 library/ 路径）：
#   例如 docker.m.daocloud.io/library/ 则 mariadb -> docker.m.daocloud.io/library/mariadb:10.11
IMAGE_PREFIX=docker.m.daocloud.io/library/
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 前端 Nginx 容器镜像（树莓派上已存在 nginx:alpine 时不会重复拉取）
WEB_IMAGE=nginx:alpine

# ---------- 数据库端口发布（仅本机） ----------
DB_PUBLISH_PORT=3306
DB_INNODB_BUFFER_POOL=1G

# ---------- 数据库备份（v1.8.0，仅超级管理员） ----------
# 独立于 ERP 源码仓库的备份 Git 目录（宿主机绝对路径），容器内挂载为 /app/db_backup。
# 该目录只保存 .sql 文本快照、备份配置与推送日志，不包含 MariaDB 原始数据文件。
BACKUP_HOST_DIR=/home/lin/erp_db_backup
# 独立 SSH 部署密钥目录（宿主机绝对路径），容器内只读挂载为 /home/app/.ssh。
# 与 ERP 源码仓库的 Git/SSH 配置完全独立，可单独授权/撤销。
BACKUP_SSH_HOST_DIR=/home/lin/.ssh/erp-backup



